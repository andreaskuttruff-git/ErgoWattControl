<!-- German texts for Theme.xml (strings of the WiX 5 HyperlinkTheme, translated, plus the app-specific ones). -->
<WixLocalization Culture="de-de" Language="1031" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="[WixBundleName] Setup" />
  <String Id="Title" Value="[WixBundleName] [WixBundleVersion]" />
  <String Id="CheckingForUpdatesLabel" Value="Suche nach Updates" />
  <String Id="UpdateButton" Value="&amp;Auf Version [WixStdBAUpdateAvailable] aktualisieren" />
  <String Id="InstallHeader" Value="Willkommen" />
  <String Id="InstallMessage" Value="Das Setup installiert [WixBundleName]. Klicke auf Installieren oder Abbrechen." />
  <String Id="InstallMessageOptions" Value="Das Setup installiert [WixBundleName]. Klicke auf Installieren, Optionen oder Abbrechen." />
  <String Id="InstallText" Value="Steuerung für das Daum ergo_bike 8008 TRS: freies Training, Strecken (GPX) fahren, Aufzeichnungen nachfahren, Trainingsprogramme, Aufzeichnung und Export für Strava &amp; Co.&#xA;&#xA;Die App wird für dich installiert (%LocalAppData%\Programs\ErgoWattControl). Fehlt die .NET 10 Desktop Runtime, wird sie mitinstalliert.&#xA;&#xA;Windows fragt nach Administratorrechten." />
  <String Id="DesktopShortcutCheckbox" Value="&amp;Verknüpfung auf dem Desktop anlegen" />
  <String Id="InstallVersion" Value="Version [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Setup wirklich abbrechen?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Vorherige Version" />
  <String Id="HelpHeader" Value="Hilfe zum Setup" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [Ordner] – installieren, reparieren, deinstallieren&#xA;   oder eine vollständige Kopie des Setups im Ordner anlegen. Standard: installieren.&#xA;&#xA;/passive | /quiet – nur Fortschritt bzw. gar keine Oberfläche, keine Rückfragen.&#xA;&#xA;/norestart – keinen Neustart versuchen.&#xA;/log log.txt – Protokoll in diese Datei (Standard: %TEMP%)." />
  <String Id="HelpCloseButton" Value="&amp;Schließen" />
  <String Id="InstallLicenseLinkText" Value="[WixBundleName] &lt;a href=&quot;#&quot;&gt;Lizenzbedingungen&lt;/a&gt;." />
