<!-- English texts for Theme.xml (strings of the WiX 5 HyperlinkTheme plus the app-specific ones): the default for every
     Windows language; a German Windows gets Theme.de.wxl (payload 1031\thm.wxl). Same ids in both files. -->
<WixLocalization Culture="en-us" Language="1033" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="[WixBundleName] Setup" />
  <String Id="Title" Value="[WixBundleName] [WixBundleVersion]" />
  <String Id="CheckingForUpdatesLabel" Value="Checking for updates" />
  <String Id="UpdateButton" Value="&amp;Update to version [WixStdBAUpdateAvailable]" />
  <String Id="InstallHeader" Value="Welcome" />
  <String Id="InstallMessage" Value="Setup installs [WixBundleName]. Click Install or Cancel." />
  <String Id="InstallMessageOptions" Value="Setup installs [WixBundleName]. Click Install, Options or Cancel." />
  <String Id="InstallText" Value="Control for the Daum ergo_bike 8008 TRS: free training, riding routes (GPX), replaying recordings, training programs, recording and export for Strava &amp; co.&#xA;&#xA;The app is installed for you (%LocalAppData%\Programs\ErgoWattControl). If the .NET 10 Desktop Runtime is missing, it is installed as well.&#xA;&#xA;Windows asks for administrator rights." />
  <String Id="DesktopShortcutCheckbox" Value="Create a &amp;desktop shortcut" />
  <String Id="InstallVersion" Value="Version [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Are you sure you want to cancel?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Previous version" />
  <String Id="HelpHeader" Value="Setup help" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [folder] – install, repair, uninstall&#xA;   or create a complete copy of the setup in the folder. Default: install.&#xA;&#xA;/passive | /quiet – progress only or no user interface at all, no questions.&#xA;&#xA;/norestart – don't try to restart.&#xA;/log log.txt – log to this file (default: %TEMP%)." />
  <String Id="HelpCloseButton" Value="&amp;Close" />
  <String Id="InstallLicenseLinkText" Value="[WixBundleName] &lt;a href=&quot;#&quot;&gt;license terms&lt;/a&gt;." />
  <String Id="InstallAcceptCheckbox" Value="I &amp;agree to the license terms" />
  <String Id="InstallOptionsButton" Value="&amp;Options" />
  <String Id="InstallInstallButton" Value="&amp;Install" />
  <String Id="InstallCancelButton" Value="&amp;Cancel" />
  <String Id="OptionsHeader" Value="Setup options" />
  <String Id="OptionsLocationLabel" Value="Install location:" />
  <String Id="OptionsBrowseButton" Value="&amp;Browse" />
  <String Id="OptionsOkButton" Value="&amp;OK" />
  <String Id="OptionsCancelButton" Value="&amp;Cancel" />
  <String Id="ProgressHeader" Value="Setup progress" />
  <String Id="ProgressLabel" Value="Processing:" />
  <String Id="OverallProgressPackageText" Value="Initializing …" />
  <String Id="ProgressCancelButton" Value="&amp;Cancel" />
  <String Id="ModifyHeader" Value="Modify setup" />
  <String Id="ModifyRepairButton" Value="&amp;Repair" />
  <String Id="ModifyUninstallButton" Value="&amp;Uninstall" />
  <String Id="ModifyCancelButton" Value="&amp;Cancel" />
  <String Id="SuccessHeader" Value="Setup successful" />
  <String Id="SuccessCacheHeader" Value="Caching complete" />
  <String Id="SuccessInstallHeader" Value="Installation complete" />
  <String Id="SuccessLayoutHeader" Value="Copy of the setup created" />
  <String Id="SuccessModifyHeader" Value="Modification complete" />
  <String Id="SuccessRepairHeader" Value="Repair complete" />
  <String Id="SuccessUninstallHeader" Value="Uninstall complete" />
  <String Id="SuccessUnsafeUninstallHeader" Value="Uninstall complete" />
  <String Id="SuccessStartText" Value="Do you want to start ErgoWattControl now? Without an ergometer connected you can try the app in demo mode – a simulated rider then pedals for you." />
  <String Id="LaunchDemoCheckbox" Value="Start in &amp;demo mode (without an ergometer)" />
  <String Id="SuccessLaunchButton" Value="&amp;Start" />
  <String Id="SuccessRestartText" Value="Please restart the computer before using the software." />
  <String Id="SuccessUninstallRestartText" Value="Please restart the computer to complete the uninstall." />
