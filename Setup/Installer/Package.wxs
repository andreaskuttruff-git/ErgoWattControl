<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ErgoWattControl" Manufacturer="Andreas Kuttruff" Version="$(var.Version)"
           UpgradeCode="d12a4843-43f4-4d37-b615-85604e51e07f" Scope="perUser" Language="1031" Codepage="1252">
    <MajorUpgrade DowngradeErrorMessage="Eine neuere Version von ErgoWattControl ist bereits installiert." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.AppDir)\ErgoWattControl.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/andreaskuttruff-git/ErgoWattControl" />
    <Property Id="ARPHELPLINK" Value="https://andreaskuttruff-git.github.io/ErgoWattControl/Hilfe.html" />
    <!-- Desktop shortcut: on by default; the setup's checkbox passes DESKTOPSHORTCUT=0 to leave it out. -->
    <Property Id="DESKTOPSHORTCUT" Value="1" />

    <!-- %LocalAppData%\Programs\ErgoWattControl, installed per user without admin rights for the app itself. Settings
         and data live in %AppData% and Documents (AppPaths) and stay on uninstall. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ErgoWattControl" />
      </Directory>
    </StandardDirectory>

    <Feature Id="App" Title="ErgoWattControl">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="RemoveFolders" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenuShortcut" Name="ErgoWattControl" Description="Steuerung für das Daum ergo_bike 8008 TRS"
                  Target="[INSTALLFOLDER]ErgoWattControl.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\ErgoWattControl" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Condition="DESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="ErgoWattControl" Description="Steuerung für das Daum ergo_bike 8008 TRS"
                  Target="[INSTALLFOLDER]ErgoWattControl.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\ErgoWattControl" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Removes the folders on uninstall if they are empty (the rider's data keeps them otherwise). -->
    <Component Id="RemoveFolders" Directory="INSTALLFOLDER">
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\ErgoWattControl" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
