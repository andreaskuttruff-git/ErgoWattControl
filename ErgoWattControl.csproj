<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Elevation profile as icon (exe, shortcuts, taskbar, setup); drawn by Setup\make-icon.py -->
    <ApplicationIcon>ErgoWattControl.ico</ApplicationIcon>
    <!-- Version of local builds (shown under Einstellungen → Info); a release build takes it from the tag instead -->
    <Version>2.0.1</Version>
    <!-- Texts in LocalizationStrings.resx are English; other languages come as satellite assemblies (de…) -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Garmin.FIT.Sdk" Version="21.218.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Training programs, shipped inside the exe and written to Documents\ErgoWattControl\Programs at start
         (ProgramFiles); the generator tool below them is a project of its own -->
    <Compile Remove="Programs\**" />
    <None Remove="Programs\**" />
    <!-- The WiX setup projects and their output are built separately (Setup\build-setup.ps1) -->
    <None Remove="Setup\**" />
    <Compile Remove="Setup\**" />
    <!-- Unit tests are a project of their own (Tests\ErgoWattControl.Tests.csproj) and may use internal members -->
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <InternalsVisibleTo Include="ErgoWattControl.Tests" />
    <EmbeddedResource Include="Programs\*.json" LogicalName="Programs/%(Filename)%(Extension)" />
    <!-- JSON schema of a program (and an example) for the rider's own programs, written to CustomPrograms\ at start -->
    <None Remove="Schema\**" />
    <EmbeddedResource Include="Schema\*.json;Schema\CLAUDE.md" LogicalName="Schema/%(Filename)%(Extension)" />
    <!-- User help (F1 / menu "Help") per language, shown from the exe in the help window (HelpWindow). WithCulture
         false: "Help.de.html" is a page of the main assembly, not a German satellite resource. Hilfe.html only
         forwards old links on the web site and is not part of the app. -->
    <None Remove="Hilfe.html;Help.*.html;HelpPics\**" />
    <EmbeddedResource Include="Help.*.html" LogicalName="Help/%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="HelpPics\*.png" LogicalName="Help/HelpPics/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The WebView2 package also references its WPF control; a WinForms app doesn't need it (and it drags in a
       WindowsBase version conflict, warning MSB3277). -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>