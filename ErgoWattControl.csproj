<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Elevation profile as icon (exe, shortcuts, taskbar, setup); drawn by Setup\make-icon.py -->
    <ApplicationIcon>ErgoWattControl.ico</ApplicationIcon>
    <!-- Version of local builds (shown under Einstellungen → Info); a release build takes it from the tag instead -->
    <Version>1.4.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Garmin.FIT.Sdk" Version="21.218.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Training programs for "Programm wiederholen", shipped inside the exe and written to Programme\ at start
         (ProgramFiles); the generator tool below them is a project of its own -->
    <Compile Remove="Programme\**" />
    <None Remove="Programme\**" />
    <!-- The WiX setup projects and their output are built separately (Setup\build-setup.ps1) -->
    <None Remove="Setup\**" />
    <Compile Remove="Setup\**" />
    <EmbeddedResource Include="Programme\*.json" LogicalName="Programme/%(Filename)%(Extension)" />
    <!-- JSON schema of a program (and an example) for the rider's own programs, written to CustomPrograms\ at start -->
    <None Remove="Schema\**" />
    <EmbeddedResource Include="Schema\*.json;Schema\CLAUDE.md" LogicalName="Schema/%(Filename)%(Extension)" />
    <!-- User help (F1 / menu "Hilfe"), shown from the exe in the help window (HelpWindow) -->
    <None Remove="Hilfe.html;Hilfe-Bilder\**" />
    <EmbeddedResource Include="Hilfe.html" LogicalName="Hilfe/Hilfe.html" />
    <EmbeddedResource Include="Hilfe-Bilder\*.png" LogicalName="Hilfe/Hilfe-Bilder/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The WebView2 package also references its WPF control; a WinForms app doesn't need it (and it drags in a
       WindowsBase version conflict, warning MSB3277). -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>